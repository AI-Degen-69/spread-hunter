#!/usr/bin/env bash
# Refuse a commit that changes core strategy logic, parameters, or architecture
# without also updating research/.
#
# Design changes, UI styling/colors, dashboard templates, and helper scripts
# do NOT require research log entries.
#
# Escape hatch:  git commit --no-verify   (typos, formatting, non-substantive)
set -e

staged=$(git diff --cached --name-only)

# Match core strategy files or algorithmic ranking logic (exclude server/design/scripts/tests)
strategy_changes=$(echo "$staged" | grep -E '^(strategy/|scripts/rank_markets\.py|scripts/rerank_loop\.py)' || true)
research=$(echo "$staged" | grep -E '^research/' || true)

if [ -n "$strategy_changes" ] && [ -z "$research" ]; then
  cat >&2 <<'MSG'

  COMMIT BLOCKED -- core strategy logic, parameters, or architecture changed without research/ update.

  Modified strategy file(s):
MSG
  echo "$strategy_changes" | sed 's/^/    - /' >&2
  cat >&2 <<'MSG'

  Strategy, parameter, and algorithmic changes require a research log entry in BOTH languages:

      research/RESEARCH_LOG.md         Question -> Method -> Result -> Verdict
      research/RESEARCH_SUMMARY.md     one dated bullet
      research/he_RESEARCH_LOG.md      Hebrew mirror
      research/he_RESEARCH_SUMMARY.md  Hebrew mirror

  Verdict vocabulary: DEAD / PARKED / LIVE / OPEN

  Non-substantive change (typo, formatting)?  git commit --no-verify

MSG
  exit 1
fi
exit 0
